# Токен бота: Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# Application ID (там же, вкладка General Information)
CLIENT_ID=
# ID сервера BLUEPRINT (ПКМ по серверу -> Копировать ID, нужен режим разработчика)
GUILD_ID=

# Необязательно: ID переживают перезаливку файлов на хостинг, а config.json — нет.
# Что задано здесь, то важнее записанного командой /setup.
